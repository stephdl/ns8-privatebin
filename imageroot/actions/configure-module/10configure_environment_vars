import os
import json
import sys
import base64
import struct
import agent

SETTINGS = [
    "name",
    "notice",
    "info",
    "expire_default",
    "expire_max",
    "discussion",
    "open_discussion",
    "burn_after_reading_selected",
    "qrcode",
    "file_upload",
    "size_limit",
    "language_selection",
    "language_default",
    "private_creators",
    "rate_limit",
]


def image_size(image):
    if image.startswith(b"\x89PNG"):
        return struct.unpack(">II", image[16:24])
    # JPEG: walk the segments up to a start of frame marker
    pos = 2
    while pos + 9 < len(image):
        marker, length = image[pos + 1], struct.unpack(">H", image[pos + 2:pos + 4])[0]
        if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
            height, width = struct.unpack(">HH", image[pos + 5:pos + 9])
            return width, height
        pos += 2 + length
    return 512, 512


data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])

# Free text like HTML breaks the systemd environment file: keep it in JSON
os.makedirs("privatebin", exist_ok=True)
with open("privatebin/settings.json.tmp", "w") as fo:
    json.dump({key: data[key] for key in SETTINGS}, fo, indent=4)
os.replace("privatebin/settings.json.tmp", "privatebin/settings.json")

logo = data.get("logo")
if logo:
    image = base64.b64decode(logo)
    mime = "image/png" if image.startswith(b"\x89PNG") else "image/jpeg"
    width, height = image_size(image)
    # The template shows img/icon.svg at 38px height: wrap the picture in an SVG of the same ratio
    svg = (
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}">'
        f'<image href="data:{mime};base64,{logo}" width="{width}" height="{height}"/>'
        '</svg>\n'
    )
    with open("privatebin/icon.svg.tmp", "w") as fo:
        fo.write(svg)
    os.replace("privatebin/icon.svg.tmp", "privatebin/icon.svg")
elif logo == "":
    try:
        os.remove("privatebin/icon.svg")
    except FileNotFoundError:
        pass

agent.run_helper("runagent", "privatebin-config").check_returncode()
