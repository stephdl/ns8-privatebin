import os
import sys
import json
import base64
import binascii
import agent

EXPIRE_ORDER = ["5min", "10min", "1hour", "1day", "1week", "1month", "1year", "never"]
LOGO_MAX_BYTES = 512 * 1024

data = json.load(sys.stdin)

agent.set_weight(os.path.basename(__file__), 0)

errors = []

if EXPIRE_ORDER.index(data["expire_default"]) > EXPIRE_ORDER.index(data["expire_max"]):
    errors.append({'field': 'expire_default', 'parameter': 'expire_default', 'value': data["expire_default"], 'error': 'expire_default_above_max'})

logo = data.get("logo")
if logo:
    try:
        image = base64.b64decode(logo, validate=True)
    except (binascii.Error, ValueError):
        image = b""
    # Only raster images: an uploaded SVG could carry scripts
    is_png = image.startswith(b"\x89PNG\r\n\x1a\n")
    is_jpeg = image.startswith(b"\xff\xd8\xff")
    if not (is_png or is_jpeg):
        errors.append({'field': 'logo', 'parameter': 'logo', 'value': '', 'error': 'logo_invalid_format'})
    elif len(image) > LOGO_MAX_BYTES:
        errors.append({'field': 'logo', 'parameter': 'logo', 'value': '', 'error': 'logo_too_large'})

if errors:
    agent.set_status('validation-failed')
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
