import os
import sys
import json
import agent

with open(os.environ["AGENT_INSTALL_DIR"] + "/etc/privatebin-defaults.json") as fi:
    settings = json.load(fi)
try:
    with open("privatebin/settings.json") as fi:
        settings.update(json.load(fi))
except FileNotFoundError:
    pass

route = agent.get_route(os.environ['MODULE_ID'])
config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "lets_encrypt": route.get('lets_encrypt', False),
    "route_configured": bool(route),
    "logo_set": os.path.isfile("privatebin/icon.svg"),
    **settings,
}

json.dump(config, fp=sys.stdout)
