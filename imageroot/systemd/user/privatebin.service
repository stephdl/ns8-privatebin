#
# This systemd unit starts a privatebin instance using Podman.
# Most parts of this file come from podman-generate-systemd.
#

[Unit]
Description=Podman privatebin.service
Requires=privatebin-app.service
Before=privatebin-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/privatebin.pid %t/privatebin.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/privatebin.pid \
    --pod-id-file %t/privatebin.pod-id \
    --name privatebin \
    --publish 127.0.0.1:${TCP_PORT}:8080 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/privatebin.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/privatebin.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/privatebin.pod-id
PIDFile=%t/privatebin.pid
Type=forking

[Install]
WantedBy=default.target
