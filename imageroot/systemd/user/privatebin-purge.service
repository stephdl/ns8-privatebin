[Unit]
Description=Delete expired PrivateBin documents
After=privatebin-app.service

[Service]
Type=oneshot
# Skip the run quietly while PrivateBin is stopped or restarting
ExecCondition=/usr/bin/systemctl --user is-active -q privatebin-app.service
SyslogIdentifier=%N
ExecStart=/usr/bin/podman exec privatebin-app administration --purge
