import json
import os
import sys

import agent

event = json.load(sys.stdin)
try:
    with open("privatebin/settings.json") as fi:
        domain = json.load(fi).get("ldap_domain", "")
except FileNotFoundError:
    domain = ""
if not domain or domain not in event.get("domains", [event.get("domain")]):
    sys.exit(0)
if "node_id" in event and str(event["node_id"]) != os.getenv("NODE_ID"):
    sys.exit(0)  # another node's ldapproxy changed

# After a restore the domain may come back after the module: bind it now,
# the bind done by configure-module failed while the domain was missing.
agent.bind_user_domains([domain])
# discover-ldap runs again before the container starts
agent.run_helper("systemctl", "--user", "-T", "try-restart", "privatebin-auth.service").check_returncode()
